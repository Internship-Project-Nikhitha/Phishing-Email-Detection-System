# Copy this file to .env and adjust. There are no secrets or API keys here.
# Do NOT commit your real .env file (it is git-ignored).

# Folder containing model.joblib and model_meta.json (created by scripts/train.py).
# Only load model folders you created yourself.
MODEL_DIR=models/latest

# Where the analysis history database is stored (git-ignored).
DB_PATH=data/history.db

# Risk levels: score >= RISK_HIGH is "high", >= RISK_MEDIUM is "medium", otherwise "low".
RISK_MEDIUM=0.4
RISK_HIGH=0.7

# Scores at or above this value are labeled "phishing".
DECISION_THRESHOLD=0.5
